<simulation type="Segregation" class="cellsociety.Model.GameRules.SegregationRule">
  <metadata>
    <title>Segregation War</title>
    <author>Ixa Sigler</author>
    <description>A segregation model with a large grid and high threshold. It's all out war!</description>
  </metadata>

  <grid rows="200" cols="200">
    <randomByCount>
      <state id="1" proportion="0.5"/>
      <state id="2" proportion="0.5"/>
    </randomByCount>
  </grid>

  <parameters>
    <param name="satisfactionThreshold" value="0.7"/>
  </parameters>
</simulation>