<simulation type="Segregation" class="cellsociety.Model.GameRules.SegregationRule"
            neighborStrategy="cellsociety.Model.NeighborStrategy.VonNeumannNeighborStrategy">
  <metadata>
    <title>Segregation Von Neumann</title>
    <author>cellsociety</author>
    <description>4 neighbors (N,E,S,W); finite edges.</description>
  </metadata>

  <grid rows="20" cols="20">
    <randomByCount>
      <state id="0" proportion="0.3"/>
      <state id="1" proportion="0.35"/>
      <state id="2" proportion="0.35"/>
    </randomByCount>
  </grid>

  <parameters>
    <param name="satisfactionThreshold" value="0.5"/>
  </parameters>
</simulation>
