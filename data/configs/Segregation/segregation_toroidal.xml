<simulation type="Segregation" class="cellsociety.Model.GameRules.SegregationRule"
            gridEdge="cellsociety.Model.GridEdge.ToroidalEdge">
  <metadata>
    <title>Segregation Toroidal</title>
    <author>cellsociety</author>
    <description>Moore neighborhood; wrap-around edges.</description>
  </metadata>

  <grid rows="20" cols="20">
    <randomByCount>
      <state id="0" proportion="0.3"/>
      <state id="1" proportion="0.35"/>
      <state id="2" proportion="0.35"/>
    </randomByCount>
  </grid>

  <parameters>
    <param name="satisfactionThreshold" value="0.5"/>
  </parameters>
</simulation>
