<simulation type="Segregation" class="cellsociety.Model.GameRules.SegregationRule">
  <metadata>
    <title>Segregation Random Proportion</title>
    <author>Ixa Sigler</author>
    <description>A segregation model with exactly 50% of each group.</description>
  </metadata>

  <grid rows="30" cols="30">
    <randomByCount>
      <state id="1" proportion="0.5"/>
      <state id="2" proportion="0.5"/>
    </randomByCount>
  </grid>

  <parameters>
    <param name="satisfactionThreshold" value="0.6"/>
  </parameters>
</simulation>
