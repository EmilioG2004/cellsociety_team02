<simulation type="SugarScape2" class="cellsociety.Model.GameRules.SugarScape2Rule"
            gridEdge="cellsociety.Model.GridEdge.MirroredEdge">
  <metadata>
    <title>SugarScape II Mirrored</title>
    <author>cellsociety</author>
    <description>Von Neumann; reflect at boundaries. Blue=male, pink=female, gray=old.</description>
  </metadata>

  <grid rows="20" cols="20">
    <randomByCount>
      <state id="100" proportion="0.18"/>
      <state id="15" proportion="0.82"/>
    </randomByCount>
  </grid>

  <parameters>
    <param name="sugarGrowBackRate" value="1"/>
    <param name="sugarGrowBackInterval" value="1"/>
    <param name="agentInitialMinimumSugar" value="8"/>
    <param name="agentInitialMaximumSugar" value="20"/>
    <param name="agentMinimumMetabolism" value="1"/>
    <param name="agentMaximumMetabolism" value="3"/>
    <param name="agentVision" value="4"/>
    <param name="agentMaxAgeMin" value="60"/>
    <param name="agentMaxAgeMax" value="100"/>
    <param name="agentFertileStart" value="12"/>
    <param name="agentFertileEnd" value="50"/>
  </parameters>
</simulation>
