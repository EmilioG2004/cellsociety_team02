<simulation type="SugarScape" class="cellsociety.Model.GameRules.SugarScapeRule">
  <metadata>
    <title>SugarScape High Metabolism</title>
    <author>cellsociety</author>
    <description>High metabolism (3–4); few agents.</description>
  </metadata>

  <grid rows="20" cols="20">
    <randomByCount>
      <state id="100" count="24"/>
      <state id="15" count="376"/>
    </randomByCount>
  </grid>

  <parameters>
    <param name="sugarGrowBackRate" value="1"/>
    <param name="sugarGrowBackInterval" value="1"/>
    <param name="agentInitialMinimumSugar" value="15"/>
    <param name="agentInitialMaximumSugar" value="30"/>
    <param name="agentMinimumMetabolism" value="3"/>
    <param name="agentMaximumMetabolism" value="4"/>
    <param name="agentVision" value="4"/>
  </parameters>
</simulation>
